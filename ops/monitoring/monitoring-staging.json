{
  "environment": "staging",
  "functions": [
    "api",
    "dbMigrationsLoop",
    "worker"
  ],
  "alarms": [
    {
      "name": "staging-api-Errors",
      "function": "api",
      "metric": "Errors",
      "threshold": 2
    },
    {
      "name": "staging-api-Throttles",
      "function": "api",
      "metric": "Throttles",
      "threshold": 5
    },
    {
      "name": "staging-api-Duration",
      "function": "api",
      "metric": "Duration",
      "threshold": 300
    },
    {
      "name": "staging-dbMigrationsLoop-Errors",
      "function": "dbMigrationsLoop",
      "metric": "Errors",
      "threshold": 2
    },
    {
      "name": "staging-dbMigrationsLoop-Throttles",
      "function": "dbMigrationsLoop",
      "metric": "Throttles",
      "threshold": 5
    },
    {
      "name": "staging-dbMigrationsLoop-Duration",
      "function": "dbMigrationsLoop",
      "metric": "Duration",
      "threshold": 300
    },
    {
      "name": "staging-worker-Errors",
      "function": "worker",
      "metric": "Errors",
      "threshold": 2
    },
    {
      "name": "staging-worker-Throttles",
      "function": "worker",
      "metric": "Throttles",
      "threshold": 5
    },
    {
      "name": "staging-worker-Duration",
      "function": "worker",
      "metric": "Duration",
      "threshold": 300
    }
  ]
}
